<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.10.xsd">

    <!-- Create documents table for document management -->
    <changeSet id="002-create-documents-table" author="migration">
        <createTable tableName="documents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)" >
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_documents_owner_id" references="users(id)"/>
            </column>
            <column name="content_type" type="VARCHAR(100)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="storage_path" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
        
        <!-- Create index on owner_id for efficient queries -->
        <createIndex indexName="idx_documents_owner_id" tableName="documents">
            <column name="owner_id"/>
        </createIndex>
        
        <!-- Create index on created_at for timestamp queries -->
        <createIndex indexName="idx_documents_created_at" tableName="documents">
            <column name="created_at"/>
        </createIndex>
        
        <!-- Create index on title for search queries -->
        <createIndex indexName="idx_documents_title" tableName="documents">
            <column name="title"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
