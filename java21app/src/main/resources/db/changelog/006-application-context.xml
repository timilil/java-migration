<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.10.xsd">

    <changeSet id="006-application-context-marker" author="system" context="application">
        <createTable tableName="application_context_marker">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="context_name" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="application_context_marker">
            <column name="id" valueNumeric="1"/>
            <column name="context_name" value="application"/>
        </insert>
    </changeSet>
</databaseChangeLog>